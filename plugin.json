                    {"id": "idl", "type": "logic.expression", "x": 1200, "y": 0, "label": "Idle clip", "config": {"names": ["assets"], "expression": "assets[1]"}},
                    {"id": "wk", "type": "logic.expression", "x": 1200, "y": 200, "label": "Walk clip", "config": {"names": ["assets"], "expression": "assets[2] || assets[1]"}},
                    {"id": "dr", "type": "logic.expression", "x": 1500, "y": -200, "label": "Folder of the mesh", "config": {"names": ["m"], "expression": "m.split('/').slice(0, -1).join('/')"}},
                    {"id": "info", "type": "text.template", "x": 1500, "y": 0, "label": "Import report", "config": {"names": ["name", "mesh", "idle", "walk", "dir"], "template": "Imported {{name}} into {{dir}}: mesh {{mesh}}, idle {{idle}}, walk {{walk}}."}},
                    {"id": "note", "type": "notify.message", "x": 1800, "y": 0, "label": "Imported", "config": {}},
                    {"id": "bp", "type": "tool.call", "x": 2100, "y": 0, "label": "Character blueprint", "config": {"name": "create_character_blueprint", "arguments_json": "{\"name\": \"{{nodes.nm.result}}_BP\", \"skeletal_mesh_path\": \"{{nodes.mp.result}}\", \"dest_folder\": \"{{nodes.dr.result}}\"}"}},
                    {"id": "ap", "type": "tool.call", "x": 2400, "y": 0, "label": "Animation preset", "config": {"name": "create_anim_preset", "arguments_json": "{\"name\": \"{{nodes.nm.result}}_Anim\", \"idle\": \"{{nodes.idl.result}}\", \"walk\": \"{{nodes.wk.result}}\", \"dest_folder\": \"{{nodes.dr.result}}\"}"}},
                    {"id": "npc", "type": "tool.call", "x": 2700, "y": 0, "label": "NPC definition", "config": {"name": "create_npc_character_definition", "arguments_json": "{\"name\": \"{{nodes.nm.result}}_NPC\", \"skeletal_mesh_path\": \"{{nodes.mp.result}}\", \"character_blueprint_path\": \"{{nodes.dr.result}}/{{nodes.nm.result}}_BP\", \"anim_preset_path\": \"{{nodes.dr.result}}/{{nodes.nm.result}}_Anim\", \"dest_folder\": \"{{nodes.dr.result}}\", \"max_health\": 100}"}},
                    {"id": "fail", "type": "notify.message", "x": 3000, "y": 0, "label": "Tell me if it fails", "config": {"on_fail": true, "inputs": {"message": "{{nodes.nm.result}} is in UEFN as an NPC definition."}}},
                    {"id": "fin", "type": "pipeline.finish", "x": 3300, "y": 0, "label": "Done", "config": {"message": "{{nodes.nm.result}} is ready in UEFN: Characters/{{nodes.nm.result}}."}}
                  ],
                  "edges": [

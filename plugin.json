{
  "id": "meshy",
  "kind": "plugin",
  "version": "1.0.23",
  "label": "Meshy",
  "description": "Meshy AI API \u2014 Discover free community models first, then text/image-to-3D, remesh/retexture/convert/resize, auto-rig, animate. Import into Blender or UEFN Content Browser.",
  "min_app_version": "1.0.0",
  "default_enabled": false,
  "data_sharing": false,
  "secret_keys": [
    "meshy_api_key"
  ],
  "contributes": {
    "settings.tabs": [
      {
        "id": "Meshy",
        "label": "Meshy",
        "icon": "assets/icon.png",
        "ui": "sections"
      }
    ],
    "settings.sections": [
      {
        "tab": "Meshy",
        "id": "account",
        "title": "Meshy",
        "description": "Paste your Meshy API key (from meshy.ai \u2192 Settings \u2192 API). Stored encrypted on this device. Powers meshy_* MCP tools for generate, remesh/retexture/convert, rig, animate, and import to Blender/UEFN.",
        "order": 10,
        "properties": [
          {
            "id": "meshy_api_key",
            "type": "secret",
            "label": "API key",
            "placeholder": "msy_\u2026",
            "testable": true,
            "description": "Get a key at https://www.meshy.ai/settings/api \u2014 required for meshy_* tools (Pro+). Use Test to verify the key against Meshy."
          }
        ]
      }
    ],
    "walkthrough": {
      "id": "meshy",
      "title": "Meshy setup",
      "auto_start": "first_enable",
      "settings_tab": "Meshy",
      "steps": [
        {
          "target": "settings.tab.meshy",
          "title": "Paste your API key",
          "body": "Create a key at meshy.ai \u2192 Settings \u2192 API (msy_\u2026), paste it here, then hit Test. Tools appear as meshy_* once this plugin is enabled. Do not run npx skills add meshy-dev/meshy-3d-agent \u2014 this plugin already ships the skill + MCP tools.",
          "advance": "next",
          "mode": "rect"
        },
        {
          "target": "settings.tab.meshy",
          "title": "Generate, rig, import",
          "body": "Agent checks Meshy Discover for FREE community models first (links in chat). Paid generate always asks via a panel question (ducky_ask_user) before confirm_spend. Land with meshy_import_to_uefn or meshy_import_to_blender. Characters: meshy_rig / animate \u2192 Blender skeletal_export.",
          "advance": "next"
        }
      ]
    },
    "agent.tools": {
      "category": "meshy",
      "intent_pattern": "\\b(meshy|meshy\\.ai|text[- ]?to[- ]?3d|image[- ]?to[- ]?3d|rig(?:ging)?|animat(?:e|ion)s?|discover|community)\\b",
      "plan_tools": [
        "meshy_balance",
        "meshy_status",
        "meshy_discover_search",
        "meshy_discover_get",
        "meshy_list_animations"
      ]
    },
    "automations": {
      "templates": [
        {
          "id": "meshy-character",
          "label": "Meshy: Character",
          "icon": "🧍",
          "category": "Characters",
          "description": "One prompt makes a rigged, animated humanoid NPC in your island: spec, concept sheet you approve, Meshy 3D + rig + animations, then into UEFN. Nothing paid runs before you approve the concept. Animals: use Tripo: Character.",
          "requires_plugins": ["meshy"],
          "bundle": {
            "version": 1,
            "root": "Meshy: Character",
            "folders": [],
            "workflows": [
              {
                "key": "character",
                "name": "Character",
                "description": "Prompt in, rigged animated NPC out. Asks only for the island (if the prompt has none), the concept approval, and after 3 failed tries.",
                "folder": "",
                "graph": {
                  "nodes": [
                    {"id": "s", "type": "start.chat", "x": 0, "y": 0, "config": {}},
                    {"id": "sp", "type": "workflow.call", "x": 260, "y": 0, "label": "Spec", "config": {"workflow_id": "@spec", "args": {"prompt": "{{prompt}}"}}},
                    {"id": "bq", "type": "flow.branch", "x": 520, "y": 0, "label": "Quadruped?", "config": {"mode": "data", "field": "spec.body", "op": "equals", "equals": "quadruped"}},
                    {"id": "nq", "type": "notify.message", "x": 780, "y": -120, "label": "Use Tripo", "config": {"inputs": {"message": "Meshy rigs humanoids; use Tripo: Character for this one. Nothing paid was run."}}},
                    {"id": "eq", "type": "flow.end", "x": 1040, "y": -120, "config": {}},
                    {"id": "sh", "type": "workflow.call", "x": 780, "y": 60, "label": "Concept sheet", "config": {"workflow_id": "@sheet"}},
                    {"id": "m3", "type": "workflow.call", "x": 1040, "y": 60, "label": "Make 3D", "config": {"workflow_id": "@make3d"}},
                    {"id": "mb", "type": "flow.branch", "x": 1300, "y": 60, "label": "Render check failed?", "config": {"mode": "data", "field": "mesh_check", "op": "contains", "contains": "FAIL"}},
                    {"id": "nm", "type": "notify.message", "x": 1560, "y": -60, "label": "Make 3D failed", "config": {"inputs": {"message": "Make 3D failed its render check: {{mesh_check}}"}}},
                    {"id": "em", "type": "flow.end", "x": 1820, "y": -60, "config": {}},
                    {"id": "rg", "type": "workflow.call", "x": 1560, "y": 120, "label": "Rig", "config": {"workflow_id": "@rig"}},
                    {"id": "gr", "type": "workflow.call", "x": 1820, "y": 120, "label": "Gear", "config": {"workflow_id": "@gear"}},
                    {"id": "sp2", "type": "workflow.call", "x": 2080, "y": 120, "label": "Ship to UEFN", "config": {"workflow_id": "@ship"}},
                    {"id": "nf", "type": "notify.message", "x": 2340, "y": 120, "label": "Tell me if it fails", "config": {"on_fail": true, "inputs": {"message": "{{run_title}} was shipped to UEFN."}}},
                    {"id": "f", "type": "pipeline.finish", "x": 2600, "y": 120, "config": {"message": "{{run_title}} is ready in UEFN."}}
                  ],
                  "edges": [
                    {"source": "s", "target": "sp", "kind": "main"},
                    {"source": "sp", "target": "bq", "kind": "main"},
                    {"source": "bq", "target": "nq", "kind": "true"},
                    {"source": "bq", "target": "sh", "kind": "false"},
                    {"source": "nq", "target": "eq", "kind": "main"},
                    {"source": "sh", "target": "m3", "kind": "main"},
                    {"source": "m3", "target": "mb", "kind": "main"},
                    {"source": "mb", "target": "nm", "kind": "true"},
                    {"source": "mb", "target": "rg", "kind": "false"},
                    {"source": "nm", "target": "em", "kind": "main"},
                    {"source": "rg", "target": "gr", "kind": "main"},
                    {"source": "gr", "target": "sp2", "kind": "main"},
                    {"source": "sp2", "target": "nf", "kind": "main"},
                    {"source": "nf", "target": "f", "kind": "main"},
                    {"source": "sp", "target": "sh", "kind": "data", "source_pin": "spec", "target_pin": "spec"},
                    {"source": "sp", "target": "sh", "kind": "data", "source_pin": "prompts", "target_pin": "prompts"},
                    {"source": "sh", "target": "m3", "kind": "data", "source_pin": "views", "target_pin": "views"},
                    {"source": "sp", "target": "m3", "kind": "data", "source_pin": "spec", "target_pin": "spec"},
                    {"source": "m3", "target": "rg", "kind": "data", "source_pin": "mesh", "target_pin": "mesh"},
                    {"source": "sp", "target": "rg", "kind": "data", "source_pin": "spec", "target_pin": "spec"},
                    {"source": "rg", "target": "gr", "kind": "data", "source_pin": "meshes", "target_pin": "meshes"},
                    {"source": "sp", "target": "gr", "kind": "data", "source_pin": "spec", "target_pin": "spec"},
                    {"source": "gr", "target": "sp2", "kind": "data", "source_pin": "meshes", "target_pin": "meshes"},
                    {"source": "sp", "target": "sp2", "kind": "data", "source_pin": "spec", "target_pin": "spec"}
                  ]
                }
              },
              {
                "key": "spec",
                "name": "Spec",
                "description": "A prompt becomes the character spec (name, body, style, palette, height, gear, animations, role, island) and the three concept-sheet prompts. Returns spec, prompts and run_title.",
                "folder": "",
                "graph": {
                  "nodes": [
                    {"id": "in", "type": "flow.input", "x": 0, "y": 0, "label": "Prompt", "config": {"inputs": [{"name": "prompt", "type": "text", "default": "zombie for Roguelike"}]}},
                    {"id": "ask", "type": "llm.extract", "x": 300, "y": 0, "label": "Write the spec", "config": {
                      "names": ["name", "body", "style", "palette", "height_m", "gear", "animations", "npc_role", "island"],
                      "system": "The text asks for a game character. Fill: name = short Title Case name (Grey Wolf); body = exactly humanoid (two legs, two arms) or quadruped (four legs); style = art style, default stylized game-ready; palette = the 3 main colors in words; height_m = realistic height in meters as a number; gear = list of up to 3 held or worn items as strings ([] for none); animations = list of animation names, idle first, walk second, then up to 3 of run, attack, bite, hurt; npc_role = one word (enemy, ally, villager, boss); island = the island or project the request names (after for or in), else null."}},
                    {"id": "fr", "type": "text.template", "x": 600, "y": 0, "label": "Front prompt", "config": {
                      "names": ["name", "style", "body", "palette", "gear"],
                      "template": "Character concept art of {{name}}, a {{style}} {{body}} character. Color palette: {{palette}}. Gear: {{gear}}. Full body, front view, standing in a relaxed A-pose with arms (or front legs) slightly away from the body, all limbs and feet visible, one single character centered, plain white background, flat even lighting, no cast shadow, no text."}},
                    {"id": "sd", "type": "input.text", "x": 600, "y": 160, "label": "Side prompt", "config": {"value": "The exact same character, same design, colors, gear and proportions, now in a left side view, same pose, full body, plain white background, no cast shadow, no text."}},
                    {"id": "bk", "type": "input.text", "x": 600, "y": 320, "label": "Back prompt", "config": {"value": "The exact same character, same design, colors, gear and proportions, now seen from directly behind, same pose, full body, plain white background, no cast shadow, no text."}},
                    {"id": "pl", "type": "list.make", "x": 900, "y": 0, "label": "Prompts", "config": {"names": ["front", "side", "back"]}},
                    {"id": "ret", "type": "flow.output", "x": 1200, "y": 0, "label": "Return", "config": {"outputs": [{"name": "spec", "type": "json"}, {"name": "prompts", "type": "json"}, {"name": "run_title", "type": "text"}]}}
                  ],
                  "edges": [
                    {"source": "in", "target": "ret", "kind": "main"},
                    {"source": "in", "target": "ask", "kind": "data", "source_pin": "prompt", "target_pin": "text"},
                    {"source": "ask", "target": "fr", "kind": "data", "source_pin": "name", "target_pin": "name"},
                    {"source": "ask", "target": "fr", "kind": "data", "source_pin": "style", "target_pin": "style"},
                    {"source": "ask", "target": "fr", "kind": "data", "source_pin": "body", "target_pin": "body"},
                    {"source": "ask", "target": "fr", "kind": "data", "source_pin": "palette", "target_pin": "palette"},
                    {"source": "ask", "target": "fr", "kind": "data", "source_pin": "gear", "target_pin": "gear"},
                    {"source": "fr", "target": "pl", "kind": "data", "source_pin": "text", "target_pin": "front"},
                    {"source": "sd", "target": "pl", "kind": "data", "source_pin": "text", "target_pin": "side"},
                    {"source": "bk", "target": "pl", "kind": "data", "source_pin": "text", "target_pin": "back"},
                    {"source": "ask", "target": "ret", "kind": "data", "source_pin": "data", "target_pin": "spec"},
                    {"source": "pl", "target": "ret", "kind": "data", "source_pin": "list", "target_pin": "prompts"},
                    {"source": "ask", "target": "ret", "kind": "data", "source_pin": "name", "target_pin": "run_title"}
                  ]
                }
              },
              {
                "key": "sheet",
                "name": "Concept sheet",
                "description": "Front, side and back views of the character (picture, edited views, background removed), checked by a vision model up to 3 times, then shown for you to approve. Returns views.",
                "folder": "",
                "graph": {
                  "nodes": [
                    {"id": "in", "type": "flow.input", "x": 0, "y": 0, "label": "Spec and prompts", "config": {"inputs": [{"name": "spec", "type": "json"}, {"name": "prompts", "type": "json"}]}},
                    {"id": "pf", "type": "logic.expression", "x": 300, "y": -200, "label": "Front prompt", "config": {"names": ["p"], "expression": "p[0]"}},
                    {"id": "ps", "type": "logic.expression", "x": 300, "y": 0, "label": "Side prompt", "config": {"names": ["p"], "expression": "p[1]"}},
                    {"id": "pb", "type": "logic.expression", "x": 300, "y": 200, "label": "Back prompt", "config": {"names": ["p"], "expression": "p[2]"}},
                    {"id": "sn", "type": "logic.expression", "x": 300, "y": 400, "label": "Name", "config": {"names": ["spec"], "expression": "spec.name"}},
                    {"id": "gen", "type": "image.generate", "x": 600, "y": -200, "label": "Front view", "config": {"spend": true}},
                    {"id": "sd", "type": "image.edit", "x": 600, "y": 0, "label": "Side view", "config": {"spend": true}},
                    {"id": "bk", "type": "image.edit", "x": 600, "y": 200, "label": "Back view", "config": {"spend": true}},
                    {"id": "rf", "type": "image.remove_bg", "x": 900, "y": -200, "label": "Front, cut out", "config": {"spend": true}},
                    {"id": "rs", "type": "image.remove_bg", "x": 900, "y": 0, "label": "Side, cut out", "config": {"spend": true}},
                    {"id": "rb", "type": "image.remove_bg", "x": 900, "y": 200, "label": "Back, cut out", "config": {"spend": true}},
                    {"id": "vw", "type": "list.make", "x": 1200, "y": 0, "label": "Views", "config": {"names": ["front", "side", "back"]}},
                    {"id": "vq", "type": "input.text", "x": 1200, "y": 200, "label": "Check question", "config": {"value": "These are the front, side and back views of one game character on a plain background. Answer PASS only if all three show the same character (same design, colors, gear), each is a full body with nothing cut off, and each is a clean single figure. Otherwise answer FAIL and say in one sentence what is wrong."}},
                    {"id": "vis", "type": "llm.vision", "x": 1500, "y": 0, "label": "Vision check", "config": {}},
                    {"id": "ok", "type": "logic.expression", "x": 1800, "y": 0, "label": "Check passed", "config": {"names": ["a"], "expression": "contains(upper(a), 'PASS') && !contains(upper(a), 'FAIL')"}},
                    {"id": "msg", "type": "text.template", "x": 1800, "y": 200, "label": "Question", "config": {"names": ["name", "verdict"], "template": "Concept sheet for {{name}} (front, side, back). Automatic check: {{verdict}}\n\nUse this goes on to 3D and rigging (these cost credits). Try again makes a new sheet. Stop ends the run."}},
                    {"id": "approve", "type": "flow.repeat", "x": 300, "y": 600, "label": "Until you approve", "config": {"max": 6}},
                    {"id": "try", "type": "flow.repeat", "x": 600, "y": 600, "label": "Make and check (3 tries)", "config": {"max": 3}},
                    {"id": "pick", "type": "flow.choose", "x": 900, "y": 600, "label": "Approve the sheet", "config": {"title": "Concept sheet", "options": "Use this, Try again, Stop"}},
                    {"id": "okc", "type": "logic.expression", "x": 1200, "y": 600, "label": "You approved", "config": {"names": ["c"], "expression": "c == 'use'"}},
                    {"id": "gate", "type": "logic.if", "x": 600, "y": 800, "label": "Approved?", "config": {"expression": "passed"}},
                    {"id": "ret", "type": "flow.output", "x": 900, "y": 800, "label": "Return", "config": {"outputs": [{"name": "views", "type": "json"}]}},
                    {"id": "miss", "type": "notify.message", "x": 900, "y": 960, "label": "Not approved", "config": {"inputs": {"message": "Concept sheet: not approved after 6 sheets, so nothing was made in 3D."}}}
                  ],
                  "edges": [
                    {"source": "in", "target": "approve", "kind": "main"},
                    {"source": "approve", "target": "try", "kind": "each"},
                    {"source": "try", "target": "pick", "kind": "done"},
                    {"source": "approve", "target": "gate", "kind": "done"},
                    {"source": "gate", "target": "ret", "kind": "true"},
                    {"source": "gate", "target": "miss", "kind": "false"},
                    {"source": "okc", "target": "approve", "kind": "data", "source_pin": "result", "target_pin": "until"},
                    {"source": "ok", "target": "try", "kind": "data", "source_pin": "result", "target_pin": "until"},
                    {"source": "in", "target": "pf", "kind": "data", "source_pin": "prompts", "target_pin": "p"},
                    {"source": "in", "target": "ps", "kind": "data", "source_pin": "prompts", "target_pin": "p"},
                    {"source": "in", "target": "pb", "kind": "data", "source_pin": "prompts", "target_pin": "p"},
                    {"source": "in", "target": "sn", "kind": "data", "source_pin": "spec", "target_pin": "spec"},
                    {"source": "pf", "target": "gen", "kind": "data", "source_pin": "result", "target_pin": "prompt"},
                    {"source": "gen", "target": "sd", "kind": "data", "source_pin": "image", "target_pin": "image"},
                    {"source": "ps", "target": "sd", "kind": "data", "source_pin": "result", "target_pin": "prompt"},
                    {"source": "gen", "target": "bk", "kind": "data", "source_pin": "image", "target_pin": "image"},
                    {"source": "pb", "target": "bk", "kind": "data", "source_pin": "result", "target_pin": "prompt"},
                    {"source": "gen", "target": "rf", "kind": "data", "source_pin": "image", "target_pin": "image"},
                    {"source": "sd", "target": "rs", "kind": "data", "source_pin": "image", "target_pin": "image"},
                    {"source": "bk", "target": "rb", "kind": "data", "source_pin": "image", "target_pin": "image"},
                    {"source": "rf", "target": "vw", "kind": "data", "source_pin": "image", "target_pin": "front"},
                    {"source": "rs", "target": "vw", "kind": "data", "source_pin": "image", "target_pin": "side"},
                    {"source": "rb", "target": "vw", "kind": "data", "source_pin": "image", "target_pin": "back"},
                    {"source": "vw", "target": "vis", "kind": "data", "source_pin": "list", "target_pin": "image"},
                    {"source": "vq", "target": "vis", "kind": "data", "source_pin": "text", "target_pin": "prompt"},
                    {"source": "vis", "target": "ok", "kind": "data", "source_pin": "text", "target_pin": "a"},
                    {"source": "sn", "target": "msg", "kind": "data", "source_pin": "result", "target_pin": "name"},
                    {"source": "vis", "target": "msg", "kind": "data", "source_pin": "text", "target_pin": "verdict"},
                    {"source": "vw", "target": "pick", "kind": "data", "source_pin": "list", "target_pin": "images"},
                    {"source": "msg", "target": "pick", "kind": "data", "source_pin": "text", "target_pin": "message"},
                    {"source": "pick", "target": "okc", "kind": "data", "source_pin": "choice", "target_pin": "c"},
                    {"source": "vw", "target": "ret", "kind": "data", "source_pin": "list", "target_pin": "views"}
                  ]
                }
              },
              {
                "key": "make3d",
                "name": "Make 3D",
                "description": "Meshy multi-view to 3D from the approved views, remesh, scale to the character's height, then a render check.",
                "folder": "",
                "graph": {
                  "nodes": [
                    {"id": "in", "type": "flow.input", "x": 0, "y": 0, "config": {"inputs": [{"name": "views", "type": "json"}, {"name": "spec", "type": "json"}]}},
                    {"id": "vf", "type": "logic.expression", "x": 260, "y": -160, "label": "Front view", "config": {"names": ["v"], "expression": "v[0]"}},
                    {"id": "vs", "type": "logic.expression", "x": 260, "y": 0, "label": "Side view", "config": {"names": ["v"], "expression": "v[1]"}},
                    {"id": "vb", "type": "logic.expression", "x": 260, "y": 160, "label": "Back view", "config": {"names": ["v"], "expression": "v[2]"}},
                    {"id": "nm", "type": "logic.expression", "x": 260, "y": 320, "label": "Name", "config": {"names": ["spec"], "expression": "spec.name"}},
                    {"id": "mv", "type": "mesh.multi_view", "x": 520, "y": 0, "label": "Meshy multi-view to 3D", "config": {"backend": "meshy_multi_image_to_3d"}},
                    {"id": "rm", "type": "mesh.remesh", "x": 780, "y": 0, "label": "Meshy remesh", "config": {"backend": "meshy_remesh", "topology": "triangle", "inputs": {"polycount": 15000}}},
                    {"id": "sc", "type": "mesh.auto_scale", "x": 1040, "y": 0, "config": {}},
                    {"id": "rd", "type": "mesh.render", "x": 1300, "y": 0, "label": "Render check", "config": {}},
                    {"id": "chk", "type": "llm.vision", "x": 1560, "y": 0, "label": "Mesh look check", "config": {"inputs": {"prompt": "Is this a clean, recognizable, single textured character with no melted or missing limbs? Answer PASS or FAIL, then one short reason."}}},
                    {"id": "out", "type": "flow.output", "x": 1820, "y": 0, "config": {"outputs": [{"name": "mesh", "type": "mesh"}, {"name": "mesh_check", "type": "text"}]}}
                  ],
                  "edges": [
                    {"source": "in", "target": "out", "kind": "main"},
                    {"source": "in", "target": "vf", "kind": "data", "source_pin": "views", "target_pin": "v"},
                    {"source": "in", "target": "vs", "kind": "data", "source_pin": "views", "target_pin": "v"},
                    {"source": "in", "target": "vb", "kind": "data", "source_pin": "views", "target_pin": "v"},
                    {"source": "in", "target": "nm", "kind": "data", "source_pin": "spec", "target_pin": "spec"},
                    {"source": "vf", "target": "mv", "kind": "data", "source_pin": "result", "target_pin": "images"},
                    {"source": "vs", "target": "mv", "kind": "data", "source_pin": "result", "target_pin": "images"},
                    {"source": "vb", "target": "mv", "kind": "data", "source_pin": "result", "target_pin": "images"},
                    {"source": "mv", "target": "rm", "kind": "data", "source_pin": "mesh", "target_pin": "mesh"},
                    {"source": "rm", "target": "sc", "kind": "data", "source_pin": "mesh", "target_pin": "mesh"},
                    {"source": "nm", "target": "sc", "kind": "data", "source_pin": "result", "target_pin": "description"},
                    {"source": "sc", "target": "rd", "kind": "data", "source_pin": "mesh", "target_pin": "mesh"},
                    {"source": "rd", "target": "chk", "kind": "data", "source_pin": "image", "target_pin": "image"},
                    {"source": "sc", "target": "out", "kind": "data", "source_pin": "mesh", "target_pin": "mesh"},
                    {"source": "chk", "target": "out", "kind": "data", "source_pin": "text", "target_pin": "mesh_check"}
                  ]
                }
              },
              {
                "key": "rig",
                "name": "Rig",
                "description": "Meshy rig (humanoids), then the animations the spec asked for. Returns meshes: the rigged model first, then one per animation.",
                "folder": "",
                "graph": {
                  "nodes": [
                    {"id": "in", "type": "flow.input", "x": 0, "y": 0, "config": {"inputs": [{"name": "mesh", "type": "mesh"}, {"name": "spec", "type": "json"}]}},
                    {"id": "ht", "type": "logic.expression", "x": 260, "y": -160, "label": "Height", "config": {"names": ["spec"], "expression": "spec.height_m"}},
                    {"id": "bd", "type": "logic.expression", "x": 260, "y": 0, "label": "Body", "config": {"names": ["spec"], "expression": "spec.body"}},
                    {"id": "al", "type": "logic.expression", "x": 260, "y": 160, "label": "Animation names", "config": {"names": ["spec"], "expression": "spec.animations.join(', ')"}},

                    {"source": "imp", "target": "mp", "kind": "data", "source_pin": "assets", "target_pin": "assets"},
                    {"source": "imp", "target": "idl", "kind": "data", "source_pin": "assets", "target_pin": "assets"},
                    {"source": "imp", "target": "wk", "kind": "data", "source_pin": "assets", "target_pin": "assets"},
                    {"source": "mp", "target": "dr", "kind": "data", "source_pin": "result", "target_pin": "m"},
                    {"source": "nm", "target": "info", "kind": "data", "source_pin": "result", "target_pin": "name"},
                    {"source": "mp", "target": "info", "kind": "data", "source_pin": "result", "target_pin": "mesh"},
                    {"source": "idl", "target": "info", "kind": "data", "source_pin": "result", "target_pin": "idle"},

              {
                "key": "ship",
                "name": "Ship to UEFN",
                "description": "Opens the island (asks which if the spec has none), imports the rigged model and its animations into Characters/<Name>, then builds the character blueprint, animation preset and NPC definition. meshes = rigged model first, then idle, walk, … Returns assets.",
                "folder": "",
                "graph": {
                  "nodes": [
                    {"id": "in", "type": "flow.input", "x": 0, "y": 0, "label": "Spec and models", "config": {"inputs": [{"name": "spec", "type": "json"}, {"name": "meshes", "type": "json"}]}},
                    {"id": "isl", "type": "logic.expression", "x": 300, "y": -200, "label": "Island", "config": {"names": ["spec"], "expression": "spec.island"}},
                    {"id": "nm", "type": "logic.expression", "x": 300, "y": 0, "label": "Name", "config": {"names": ["spec"], "expression": "spec.name"}},
                    {"id": "fold", "type": "text.template", "x": 600, "y": 0, "label": "Content folder", "config": {"names": ["name"], "template": "Characters/{{name}}"}},
                    {"id": "open", "type": "uefn.open_project", "x": 600, "y": -200, "label": "Open the island", "config": {}},
